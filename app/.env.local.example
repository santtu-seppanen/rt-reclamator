# Kopioi tämä tiedosto nimelle .env.local (gitignorattu) ja täytä arvot.
# VITE_API_URL on pakollinen jo pelkkään selailuun: kuvahistoria haetaan
# ajonaikaisesti Workerista (GET /analyysit, /kuvat/*). Ilman
# VITE_JAETTU_SALASANA-arvoa kuvan lähetys (POST /analysoi) epäonnistuu.

VITE_API_URL=https://esimerkki-worker.example.workers.dev
VITE_JAETTU_SALASANA=vaihda-tama-jaettuun-salasanaan
